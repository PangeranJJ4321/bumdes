generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* =======================
   ENUMS
======================= */

model BusinessUnit {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  users       User[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("business_units")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/* =======================
   MODELS
   ======================= */

model Product {
  id          String           @id @default(uuid())
  name        String
  price       Int
  promoPrice  Int?             @map("promo_price")
  isPromo     Boolean          @default(false) @map("is_promo")
  description String?
  
  // Replaced category enum with BusinessUnit relation
  businessUnitId String        @map("business_unit_id")
  businessUnit   BusinessUnit  @relation(fields: [businessUnitId], references: [id])
  
  imageUrl    String?          @map("image_url")
  stock       Int              @default(0)
  isOnlineOrder Boolean        @default(true) @map("is_online_order")
  
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation(fields: [createdById], references: [id])

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  reviews     Review[]
  orderItems  OrderItem[]

  @@index([businessUnitId])
  @@map("products")
}

model Order {
  id              String        @id @default(uuid())
  customerName    String        @map("customer_name")
  customerAddress String        @map("customer_address")
  customerPhone   String?       @map("customer_phone")
  items           Json          // snapshot saat checkout
  totalPrice      Int           @map("total_price")
  status          OrderStatus   @default(PENDING)
  deliveryMethod  String        @default("PICKUP") @map("delivery_method") // PICKUP or COURIER
  notes           String?
  whatsappUrl     String?       @map("whatsapp_url")
  waOptIn         Boolean       @default(false) @map("wa_opt_in")
  waOptInAt       DateTime?     @map("wa_opt_in_at")
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  itemsDetail     OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int
  price     Int      // snapshot harga saat checkout

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id         String        @id @default(uuid())
  productId  String        @map("product_id")
  rating     Int           // 1 - 5
  comment    String?
  authorName String        @default("Anonymous") @map("author_name")
  status     ReviewStatus  @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}


enum UserRole {
  SUPER_ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  password      String?   // Hashed password
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(STAFF) // SUPER_ADMIN, STAFF
  isActive      Boolean   @default(true) @map("is_active")
  phone         String?   // Add phone number field
  
  // Replaced unit enum with BusinessUnit relation
  unitId        String?   @map("unit_id")
  unit          BusinessUnit? @relation(fields: [unitId], references: [id])
  
  products      Product[] // Products created by this user
  accounts      Account[]
  sessions      Session[]
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model News {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String   // Rich Text/HTML
  thumbnail   String?
  author      String
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  comments    Comment[]

  @@map("news")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  name      String
  email     String
  newsId    String   @map("news_id")
  createdAt DateTime @default(now()) @map("created_at")
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId])
  @@map("comments")
}

model Gallery {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String   @map("image_url")
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("gallery")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SiteSettings {
    id              String   @id @default(cuid())
    key             String   @unique // e.g., "general" to have only one row or allowing multiple config sets
    
    // Contact Info
    contactName     String?  @default("BUMDes Kalosi") @map("contact_name")
    contactEmail    String?  @map("contact_email")
    contactPhone    String?  @map("contact_phone")
    address         String?  @map("address")
    
    // Operating Hours (simple text for now, or JSON structure)
    operatingHours  String?  @map("operating_hours")
    
    // Social Media
    facebookUrl     String?  @map("facebook_url")
    instagramUrl    String?  @map("instagram_url")
    tiktokUrl       String?  @map("tiktok_url")
    youtubeUrl      String?  @map("youtube_url")

    updatedAt       DateTime @updatedAt @map("updated_at")

    @@map("site_settings")
}